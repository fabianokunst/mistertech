# Mistertech — configuração para Apache/LiteSpeed (Hostinger)

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS e domínio sem www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://mistertech.com.br%{REQUEST_URI} [L,R=301]

  # URLs do site antigo (WordPress) que mudaram
  RewriteRule ^essential/?$ /acessorios/ [L,R=301]
  RewriteRule ^shop/?$ /acessorios/ [L,R=301]
  RewriteRule ^sem-categoria/?$ /acessorios/ [L,R=301]
  RewriteRule ^policita-de-trocas/?$ /politica-de-trocas/ [L,R=301]
  RewriteRule ^garantia-estendida/?$ /politica-de-trocas/#garantia [L,R=301,NE]
  RewriteRule ^quiosques-mistertech/?$ /onde-comprar/ [L,R=301]
  RewriteRule ^(sitemap_index|page-sitemap|product-sitemap|product_cat-sitemap|wp-sitemap)\.xml$ /sitemap-index.xml [L,R=301]
  RewriteRule ^feed/?$ / [L,R=301]

  # Barra final nas páginas (padrão do site)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$ [NC]
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Arquivos com hash no nome (gerados pelo build) podem ficar em cache por 1 ano
  <FilesMatch "^.*\.[a-zA-Z0-9_-]{8,}\.(css|js|webp|avif|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
