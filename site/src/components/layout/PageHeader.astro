---
/** Abertura das páginas internas: trilha, título e texto de apoio. */
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  icon?: IconName;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, lead, eyebrow, icon, breadcrumbs } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <div class="page-header__body">
      {
        icon && (
          <span class="page-header__icon">
            <Icon name={icon} size={28} />
          </span>
        )
      }
      <div class="page-header__text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-8) clamp(var(--space-10), 5vw, var(--space-16));
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  /* Detalhe de marca: arco amarelo no canto, ecoando o símbolo "mt". */
  .page-header::after {
    content: '';
    position: absolute;
    right: -120px;
    top: -160px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    border: 56px solid var(--yellow-500);
    opacity: 0.9;
    pointer-events: none;
  }

  .page-header__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .page-header__text {
    display: grid;
    gap: var(--space-3);
    max-width: 760px;
  }

  .page-header__icon {
    display: inline-grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    background: var(--ink-950);
    color: var(--yellow-500);
  }

  @media (max-width: 640px) {
    .page-header::after {
      right: -200px;
      top: -220px;
    }
  }
</style>
