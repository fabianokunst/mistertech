---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import { categorias } from '../../data/categorias';
import { url } from '../../lib/url';

const ajuda = [
  { href: '/suporte-e-trocas/', label: 'Suporte e trocas' },
  { href: '/politica-de-trocas/', label: 'Trocas e garantia' },
  { href: '/onde-comprar/', label: 'Onde comprar' },
  { href: '/contato/', label: 'Contato' },
];
const ano = new Date().getFullYear();
---

<footer class="site-footer theme-dark">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo variant="negativo" height={28} />
        <p class="site-footer__slogan">{site.slogan}</p>
        <ul role="list" class="site-footer__social">
          <li>
            <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram da Mistertech (abre em nova aba)">
              <Icon name="instagram" size={22} />
            </a>
          </li>
          <li>
            <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook da Mistertech (abre em nova aba)">
              <Icon name="facebook" size={22} />
            </a>
          </li>
        </ul>
      </div>

      <nav class="site-footer__col" aria-labelledby="rodape-acessorios">
        <h2 id="rodape-acessorios" class="site-footer__title">Acessórios</h2>
        <ul role="list">
          <li><a href={url('/acessorios/')}>Todos os produtos</a></li>
          {categorias.map((c) => <li><a href={url(`/${c.slug}/`)}>{c.nome}</a></li>)}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-labelledby="rodape-ajuda">
        <h2 id="rodape-ajuda" class="site-footer__title">Ajuda</h2>
        <ul role="list">
          {ajuda.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Atendimento</h2>
        <ul role="list" class="site-footer__contact">
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          {
            site.horario.map((h) => (
              <li>
                <Icon name="clock" size={18} />
                <span>
                  {h.dias}, {h.horas}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        © {ano} Mistertech. Uma marca do {site.grupo.nome} · CNPJ {site.grupo.cnpj}
      </p>
      <button type="button" class="site-footer__cookies" data-open-consent>
        <Icon name="cookie" size={16} />
        Preferências de cookies
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-16) var(--space-8);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    }
  }

  .site-footer__slogan {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    max-width: 30ch;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .site-footer__social a {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .site-footer__social a:hover {
    background: var(--yellow-500);
    border-color: var(--yellow-500);
    color: var(--ink-950);
  }

  .site-footer__title {
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-accent);
  }

  .site-footer__col ul {
    display: grid;
    gap: var(--space-3);
  }

  .site-footer__col a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--yellow-500);
  }

  .site-footer__contact li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    color: var(--color-text-muted);
  }

  .site-footer__contact :global(.icon) {
    margin-top: 1px;
    color: var(--color-text-subtle);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    color: var(--color-text-subtle);
  }

  .site-footer__cookies {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__cookies:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>
