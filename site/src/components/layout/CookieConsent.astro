---
/**
 * Consentimento de cookies (LGPD) + SAP Emarsys.
 * - Nada da Emarsys carrega antes do aceite; recusar tem o mesmo peso que aceitar.
 * - A escolha fica no localStorage com data e versão da política. Vale por 12 meses
 *   ou até a versão mudar (site.privacidade.versao); depois disso o aviso volta.
 * - Sem consentimento válido, os cookies e dados que a Emarsys gravou são apagados.
 * - O botão "Preferências de cookies" (rodapé e política) reabre o aviso.
 */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';
import { url } from '../../lib/url';

const merchant = Astro.site?.hostname === site.emarsys.dominio ? site.emarsys.merchantId : '';
---

<div
  class="consent"
  role="region"
  aria-labelledby="consent-titulo"
  tabindex="-1"
  hidden
  data-consent
  data-merchant={merchant}
  data-versao={site.privacidade.versao}
>
  <div class="consent__body">
    <Icon name="cookie" size={24} class="consent__icon" />
    <div>
      <p class="consent__title" id="consent-titulo">Cookies e privacidade</p>
      <p class="consent__text">
        Com a sua permissão, usamos cookies do SAP Emarsys para entender como o site é usado e personalizar conteúdo e
        ofertas do {site.grupo.nome}. Se recusar, nada disso é ativado e o site funciona do mesmo jeito. Você pode mudar de
        ideia quando quiser em “Preferências de cookies”, no rodapé.
      </p>
      <a class="consent__link" href={url('/politica-de-privacidade/#cookies')}>Saiba mais na política de privacidade</a>
    </div>
  </div>
  <div class="consent__actions">
    <Button size="sm" variant="secondary" data-consent-choice="recusado">Recusar</Button>
    <Button size="sm" variant="secondary" data-consent-choice="aceito">Aceitar</Button>
  </div>
</div>

<script>
  type Scarab = unknown[] & { push: (...args: unknown[]) => number };
  type Window = typeof globalThis & { ScarabQueue?: Scarab };
  type Escolha = 'aceito' | 'recusado';
  type Registro = { escolha: Escolha; versao: number; data: string };

  const CHAVE = 'mt-consentimento';
  const VALIDADE_DIAS = 365;
  /** Cookies e chaves de armazenamento que a Emarsys grava no domínio do site. */
  const DADOS_EMARSYS = /^scarab/i;

  const banner = document.querySelector<HTMLElement>('[data-consent]');
  const merchant = banner?.dataset.merchant ?? '';
  const versao = Number(banner?.dataset.versao ?? 1);
  const w = window as Window;
  let quemAbriu: HTMLElement | null = null;

  /** Escolha ainda válida: mesma versão da política e dentro do prazo. Senão, null. */
  function ler(): Escolha | null {
    try {
      const registro = JSON.parse(localStorage.getItem(CHAVE) ?? 'null') as Registro | null;
      if (!registro || registro.versao !== versao) return null;
      const dias = (Date.now() - Date.parse(registro.data)) / 86_400_000;
      if (!(dias >= 0 && dias < VALIDADE_DIAS)) return null;
      return registro.escolha === 'aceito' || registro.escolha === 'recusado' ? registro.escolha : null;
    } catch {
      return null;
    }
  }

  function gravar(escolha: Escolha) {
    const registro: Registro = { escolha, versao, data: new Date().toISOString() };
    try {
      localStorage.setItem(CHAVE, JSON.stringify(registro));
    } catch {
      /* navegação privada: vale só para esta página */
    }
  }

  /** Apaga o que a Emarsys gravou no domínio do site (cookies, localStorage e sessionStorage). */
  function apagarDadosEmarsys() {
    const partes = location.hostname.split('.');
    const dominios = ['', ...partes.slice(0, -1).map((_, i) => `; domain=.${partes.slice(i).join('.')}`)];
    document.cookie
      .split(';')
      .map((c) => c.split('=')[0].trim())
      .filter((nome) => DADOS_EMARSYS.test(nome))
      .forEach((nome) => dominios.forEach((d) => (document.cookie = `${nome}=; max-age=0; path=/${d}`)));
    for (const armazenamento of ['localStorage', 'sessionStorage'] as const) {
      try {
        const loja = window[armazenamento];
        Object.keys(loja)
          .filter((chave) => DADOS_EMARSYS.test(chave))
          .forEach((chave) => loja.removeItem(chave));
      } catch {
        /* armazenamento bloqueado */
      }
    }
  }

  function carregarEmarsys() {
    if (!merchant || document.getElementById('scarab-js-api')) return;
    w.ScarabQueue = w.ScarabQueue || ([] as unknown as Scarab);
    const js = document.createElement('script');
    js.id = 'scarab-js-api';
    js.async = true;
    js.src = `https://cdn.scarabresearch.com/js/${merchant}/scarab-v2.js`;
    document.head.appendChild(js);
    w.ScarabQueue.push(['go']);
  }

  /** Eventos personalizados (mesmos nomes do site antigo). Só funcionam depois do aceite. */
  function rastrear(...comando: unknown[]) {
    if (!w.ScarabQueue) return;
    w.ScarabQueue.push(comando);
    w.ScarabQueue.push(['go']);
  }

  document.addEventListener('click', (e) => {
    const alvo = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-track]');
    if (!alvo) return;
    if (alvo.dataset.track === 'menu') {
      rastrear('tag', 'menu_click', { categoria_menu: alvo.textContent?.trim(), categoria_url: alvo.href });
    } else if (alvo.dataset.track === 'produto') {
      rastrear('tag', 'product_click', { id: alvo.dataset.id, sku: alvo.dataset.sku, name: alvo.dataset.name, url: alvo.href });
    }
  });

  // Só o assunto: nome, e-mail e mensagem não vão para a Emarsys. O consentimento de
  // cookies não cobre identificar a pessoa para marketing, e o formulário promete
  // usar os dados só para responder.
  document.addEventListener('mt:contato', (e) => {
    const { assunto } = (e as CustomEvent<{ assunto: string }>).detail;
    rastrear('tag', 'contato_formulario', { assunto });
  });

  function abrir(origem: HTMLElement | null) {
    if (!banner) return;
    quemAbriu = origem;
    banner.hidden = false;
    if (origem) banner.focus();
  }

  function fechar() {
    if (!banner) return;
    banner.hidden = true;
    quemAbriu?.focus();
    quemAbriu = null;
  }

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((botao) => {
    botao.addEventListener('click', () => {
      const escolha = botao.dataset.consentChoice as Escolha;
      gravar(escolha);
      fechar();
      if (escolha === 'aceito') return carregarEmarsys();
      apagarDadosEmarsys();
      // O script já rodou nesta página: recarrega para tirá-lo da memória.
      if (document.getElementById('scarab-js-api')) location.reload();
    });
  });

  document
    .querySelectorAll<HTMLElement>('[data-open-consent]')
    .forEach((el) => el.addEventListener('click', () => abrir(el)));

  const atual = ler();
  if (atual === 'aceito') carregarEmarsys();
  else apagarDadosEmarsys();
  if (atual === null) abrir(null);
</script>

<style>
  .consent {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: var(--z-overlay);
    display: grid;
    gap: var(--space-4);
    max-width: 460px;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    animation: subir var(--duration-slow) var(--ease-out);
  }

  .consent[hidden] {
    display: none;
  }

  .consent:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .consent__body {
    display: flex;
    gap: var(--space-3);
  }

  .consent :global(.consent__icon) {
    flex-shrink: 0;
    color: var(--yellow-700);
  }

  .consent__title {
    font-weight: var(--weight-bold);
  }

  .consent__text {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .consent__link {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  .consent__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
