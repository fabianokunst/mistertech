---
/** Metadados da página: título, descrição, canonical, Open Graph e ícones. */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ogPadrao from '../../assets/fotos/carregadores.jpg';
import { site } from '../../data/site';
import { url } from '../../lib/url';

export interface SeoProps {
  title: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  type?: 'website' | 'product';
}

const { title, description = site.descricao, image = ogPadrao, noindex = false, type = 'website' } = Astro.props as SeoProps;

const fullTitle = title === site.nome ? `${site.nome} — ${site.slogan}` : `${title} | ${site.nome}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'contain', background: '#ffffff', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={site.nome} />
<meta property="og:type" content={type === 'product' ? 'product' : 'website'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
<link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<meta name="theme-color" content="#0b0b0a" />
