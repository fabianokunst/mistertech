---
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { navegacao } from '../../data/site';
import { categorias } from '../../data/categorias';
import { url } from '../../lib/url';

interface Props {
  /** href da seção ativa (ex.: '/acessorios/'). */
  secao?: string;
}

const { secao } = Astro.props;
const links = navegacao.filter((n) => n.href !== '/onde-comprar/');
const isAtual = (href: string) => secao === href;
---

<header class="site-header" data-header>
  <div class="container site-header__bar">
    <Logo height={26} />

    <nav class="site-header__nav" aria-label="Principal">
      <ul role="list">
        {
          links.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isAtual(item.href) ? 'page' : undefined} data-track="menu">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/onde-comprar/" size="sm" icon="store" iconPosition="start" data-track="menu">Onde comprar</Button>
    </nav>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-mobile"
      data-menu-toggle
    >
      <span class="site-header__toggle-open"><Icon name="menu" size={24} /></span>
      <span class="site-header__toggle-close"><Icon name="x" size={24} /></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>

  <div id="menu-mobile" class="menu-mobile" hidden data-menu>
    <nav class="container" aria-label="Menu">
      <ul role="list" class="menu-mobile__main">
        {
          navegacao.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isAtual(item.href) ? 'page' : undefined} data-track="menu">
                {item.label}
                <Icon name="chevron-right" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow menu-mobile__label">Categorias</p>
      <ul role="list" class="menu-mobile__cats">
        {
          categorias.map((c) => (
            <li>
              <a href={url(`/${c.slug}/`)} data-track="menu">
                <Icon name={c.icone} size={20} />
                {c.nome}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.documentElement.classList.toggle('menu-aberto', open);
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Sombra no cabeçalho depois de rolar a página.
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-xs);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: var(--header-height);
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: var(--space-6);
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-1);
  }

  .site-header__nav a:not(.btn) {
    position: relative;
    display: inline-flex;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-header__nav a:not(.btn):hover {
    color: var(--color-text);
    background: var(--color-bg-subtle);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .site-header__nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: -2px;
    height: 3px;
    border-radius: 3px;
    background: var(--color-accent);
  }

  .site-header__toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
  }

  .site-header__toggle:hover {
    background: var(--color-bg-subtle);
  }

  .site-header__toggle-close,
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-open {
    display: none;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-close {
    display: contents;
  }

  .menu-mobile {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    overflow-y: auto;
    padding-block: var(--space-4) var(--space-12);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .menu-mobile__main a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: var(--text-xl);
    color: var(--color-text);
    text-decoration: none;
  }

  .menu-mobile__main a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 3px;
  }

  .menu-mobile__label {
    margin: var(--space-8) 0 var(--space-3);
    color: var(--color-text-subtle);
  }

  .menu-mobile__cats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .menu-mobile__cats a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    text-decoration: none;
  }

  :global(html.menu-aberto) {
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .site-header__nav {
      display: flex;
    }

    .site-header__toggle,
    .menu-mobile {
      display: none !important;
    }
  }
</style>
