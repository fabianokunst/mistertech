---
/**
 * Cabeçalho de seção: sobretítulo, título, texto de apoio e ações
 * (slot "actions", alinhado à direita em telas largas).
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  as?: 'h1' | 'h2' | 'h3';
  align?: 'start' | 'center';
  id?: string;
}

const { eyebrow, title, lead, as: Tag = 'h2', align = 'start', id } = Astro.props;
const hasActions = Astro.slots.has('actions');
---

<header class:list={['section-header', `section-header--${align}`, hasActions && 'section-header--with-actions']}>
  <div class="section-header__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag id={id} class="section-header__title">{title}</Tag>
    {lead && <p class="lead">{lead}</p>}
  </div>
  {
    hasActions && (
      <div class="section-header__actions">
        <slot name="actions" />
      </div>
    )
  }
</header>

<style>
  .section-header {
    display: grid;
    gap: var(--space-6);
    margin-bottom: clamp(var(--space-8), 4vw, var(--space-12));
  }

  .section-header__text {
    display: grid;
    gap: var(--space-3);
  }

  .section-header--center {
    justify-items: center;
    text-align: center;
  }

  .section-header--center .lead {
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .section-header--with-actions {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
