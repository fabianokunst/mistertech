---
/** Etiqueta curta: categoria, selo de certificação, característica. */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  variant?: 'neutral' | 'accent' | 'inverse' | 'outline' | 'success';
  size?: 'sm' | 'md';
  icon?: IconName;
  class?: string;
}

const { variant = 'neutral', size = 'md', icon, class: className } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`, `badge--${size}`, className]}>
  {icon && <Icon name={icon} size={size === 'sm' ? 13 : 15} />}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    line-height: 1.2;
    white-space: nowrap;
  }

  .badge--sm {
    padding: 0.2rem 0.55rem;
    font-size: var(--text-xs);
  }

  .badge--md {
    padding: 0.35rem 0.75rem;
    font-size: var(--text-sm);
  }

  .badge--neutral {
    background: var(--color-bg-muted);
    color: var(--color-text);
  }

  .badge--accent {
    background: var(--yellow-500);
    color: var(--ink-950);
  }

  .badge--inverse {
    background: var(--ink-950);
    color: var(--ink-0);
  }

  .badge--outline {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .badge--success {
    background: var(--color-success-bg);
    color: var(--color-success);
  }
</style>
