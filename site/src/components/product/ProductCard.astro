---
/** Card de produto. O cartão inteiro é clicável (link "esticado" no título). */
import { Image } from 'astro:assets';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { getCategoria } from '../../data/categorias';
import { textoDeBusca, type Produto } from '../../lib/produtos';
import { semQuebras } from '../../lib/texto';
import { url } from '../../lib/url';

interface Props {
  produto: Produto;
  as?: 'h2' | 'h3';
  eager?: boolean;
}

const { produto, as: Tag = 'h3', eager = false } = Astro.props;
const { nome, resumo, destaques, imagens, categoria, referencia } = produto.data;
const cat = getCategoria(categoria);
const capa = imagens[0];
---

<article class="product-card" data-produto data-categoria={categoria} data-busca={textoDeBusca(produto, cat.nome)}>
  <div class="product-card__media">
    <Image
      src={capa.src}
      alt={capa.alt}
      widths={[320, 480, 640]}
      sizes="(min-width: 1200px) 280px, (min-width: 640px) 45vw, 90vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="product-card__body">
    <p class="product-card__cat">{cat.nome}</p>
    <Tag class="product-card__title">
      <a
        href={url(`/${produto.id}/`)}
        class="product-card__link"
        data-track="produto"
        data-id={produto.id}
        data-sku={referencia}
        data-name={nome}
        set:html={semQuebras(nome)}
      />
    </Tag>
    <p class="product-card__resumo" set:html={semQuebras(resumo)} />
    {
      destaques.length > 0 && (
        <ul role="list" class="product-card__tags">
          {destaques.slice(0, 3).map((d) => (
            <li>
              <Badge size="sm">{d}</Badge>
            </li>
          ))}
        </ul>
      )
    }
    <span class="product-card__cta" aria-hidden="true">
      Ver detalhes <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-strong);
  }

  .product-card:focus-within {
    box-shadow: var(--shadow-focus);
  }

  .product-card__media {
    aspect-ratio: 1;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .product-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-4);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .product-card:hover .product-card__media :global(img) {
    transform: scale(1.04);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .product-card__cat {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .product-card__title {
    font-size: var(--text-lg);
  }

  .product-card__link {
    color: inherit;
    text-decoration: none;
  }

  .product-card__link:focus-visible {
    outline: none;
  }

  /* Link esticado: o card inteiro vira área clicável. */
  .product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .product-card__resumo {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .product-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  .product-card__cta :global(.icon) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .product-card:hover .product-card__cta :global(.icon) {
    transform: translateX(3px);
  }
</style>
