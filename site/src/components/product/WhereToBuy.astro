---
/**
 * Quadro "Onde comprar" da página de produto. Substitui o antigo botão
 * "Compre em nossos quiosques", que levava a uma página inexistente.
 */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import type { Loja } from '../../data/lojas';

interface Props {
  lojas: (Loja & { href: string })[];
}

const { lojas } = Astro.props;
---

<section class="buy-box" aria-labelledby="onde-comprar-titulo">
  <h2 id="onde-comprar-titulo" class="buy-box__title">
    <Icon name="shopping-bag" size={20} />
    Onde comprar
  </h2>
  <p class="buy-box__text">A compra é finalizada no site de um parceiro oficial Mistertech.</p>
  <ul role="list" class="buy-box__list">
    {
      lojas.map((loja) => (
        <li>
          <a href={loja.href} target="_blank" rel="noopener" class="buy-box__store">
            <span class="buy-box__logo">
              <Image src={loja.logo} alt="" height={44} densities={[1, 2]} />
            </span>
            <span class="buy-box__name">
              {loja.nome}
              <small>{loja.publico}</small>
            </span>
            <Icon name="arrow-up-right" size={18} class="buy-box__arrow" />
            <span class="visually-hidden">(abre em nova aba)</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .buy-box {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }

  .buy-box__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
  }

  .buy-box__text {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .buy-box__list {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  @media (min-width: 520px) {
    .buy-box__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .buy-box__store {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .buy-box__store:hover {
    border-color: var(--ink-950);
    box-shadow: var(--shadow-sm);
  }

  .buy-box__logo {
    display: grid;
    place-items: center;
    width: 84px;
    height: 44px;
    flex-shrink: 0;
  }

  .buy-box__logo :global(img) {
    max-width: 84px;
    max-height: 44px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .buy-box__name {
    display: grid;
    flex: 1;
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .buy-box__name small {
    font-weight: var(--weight-regular);
    color: var(--color-text-subtle);
  }

  .buy-box :global(.buy-box__arrow) {
    color: var(--color-text-subtle);
  }

  .buy-box__store:hover :global(.buy-box__arrow) {
    color: var(--color-text);
  }
</style>
