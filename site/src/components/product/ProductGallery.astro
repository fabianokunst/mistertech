---
/**
 * Galeria de fotos: faixa com rolagem horizontal (desliza no celular e
 * funciona sem JS) + miniaturas e setas que avançam a faixa.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';

interface Props {
  imagens: { src: ImageMetadata; alt: string }[];
}

const { imagens } = Astro.props;
const total = imagens.length;
---

<div class="gallery" data-gallery>
  <div class="gallery__stage">
    <div class="gallery__track" data-gallery-track tabindex="0" role="region" aria-label="Fotos do produto">
      {
        imagens.map((img, i) => (
          <figure class="gallery__slide" aria-label={`Foto ${i + 1} de ${total}`}>
            <Image
              src={img.src}
              alt={img.alt}
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 1024px) 560px, 92vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </figure>
        ))
      }
    </div>
    {
      total > 1 && (
        <>
          <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="Foto anterior">
            <Icon name="chevron-left" size={22} />
          </button>
          <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="Próxima foto">
            <Icon name="chevron-right" size={22} />
          </button>
        </>
      )
    }
  </div>

  {
    total > 1 && (
      <div class="gallery__thumbs" role="group" aria-label="Escolher foto">
        {imagens.map((img, i) => (
          <button
            type="button"
            class="gallery__thumb"
            data-gallery-thumb={i}
            aria-label={`Ver foto ${i + 1} de ${total}`}
            aria-current={i === 0 ? 'true' : 'false'}
          >
            <Image src={img.src} alt="" width={88} height={88} densities={[1, 2]} loading="lazy" />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]')!;
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];
    const total = track.children.length;
    const atual = () => Math.round(track.scrollLeft / track.clientWidth);

    const ir = (i: number) => {
      const alvo = (i + total) % total;
      track.scrollTo({ left: alvo * track.clientWidth, behavior: 'smooth' });
    };

    thumbs.forEach((t) => t.addEventListener('click', () => ir(Number(t.dataset.galleryThumb))));
    gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => ir(atual() - 1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => ir(atual() + 1));

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') ir(atual() + 1);
      if (e.key === 'ArrowLeft') ir(atual() - 1);
    });

    let quadro = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(quadro);
        quadro = requestAnimationFrame(() => {
          const i = atual();
          thumbs.forEach((t, n) => t.setAttribute('aria-current', String(n === i)));
        });
      },
      { passive: true },
    );
  });
</script>

<style>
  .gallery {
    display: grid;
    gap: var(--space-3);
  }

  .gallery__stage {
    position: relative;
  }

  .gallery__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #fff;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__track:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }

  .gallery__slide {
    flex: 0 0 100%;
    aspect-ratio: 1;
    scroll-snap-align: start;
    display: grid;
    place-items: center;
  }

  .gallery__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(var(--space-4), 4vw, var(--space-10));
  }

  .gallery__arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.92);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .gallery__arrow:hover {
    background: var(--yellow-500);
    border-color: var(--yellow-500);
  }

  .gallery__arrow--prev {
    left: var(--space-3);
  }

  .gallery__arrow--next {
    right: var(--space-3);
  }

  .gallery__stage:hover .gallery__arrow,
  .gallery__arrow:focus-visible {
    opacity: 1;
  }

  @media (hover: none) {
    .gallery__arrow {
      display: none;
    }
  }

  .gallery__thumbs {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding: 2px;
  }

  .gallery__thumb {
    flex: 0 0 auto;
    width: 76px;
    height: 76px;
    padding: var(--space-1);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #fff;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .gallery__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery__thumb:hover {
    border-color: var(--color-border-strong);
  }

  .gallery__thumb[aria-current='true'] {
    border-color: var(--ink-950);
  }
</style>
